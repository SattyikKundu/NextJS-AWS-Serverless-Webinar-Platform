# Public URL of the AWS API Gateway endpoint.
# This value may be exposed to the browser.
NEXT_PUBLIC_API_BASE_URL=

# Public URL of the WordPress marketing website.
NEXT_PUBLIC_WORDPRESS_SITE_URL=

# AWS Cognito user pool identifier.
# Keep actual authentication configuration out of source code.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=

# AWS Cognito public application client identifier.
# Never use a Cognito client secret in browser-side code.
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# AWS region containing the application's backend resources.
NEXT_PUBLIC_AWS_REGION=