
# Node.js dependencies.
**/node_modules/

# Next.js build and development output.
**/.next/
**/out/
**/build/
**/dist/

# Local environment variables and secrets.
.env
.env.*
**/.env
**/.env.*

# Allow documented, non-sensitive environment examples.
!.env.example
!**/.env.example

# AWS SAM build and deployment artifacts.
**/.aws-sam/

# AWS credentials and local configuration.
.aws/
**/credentials

# Local test coverage and temporary files.
**/coverage/
**/.cache/
*.log
*.tmp

# Operating system and editor-generated files.
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# TypeScript incremental build cache.
*.tsbuildinfo

# Python caches used by optional AWS tooling.
**/__pycache__/
*.pyc

# Local backup files.
*.bak
*.backup
